# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# API key bisa dibuat di https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Set true hanya jika key kamu adalah key Vertex AI (lihat bagian Troubleshooting di README)
USE_VERTEX_AI=false

# Model (opsional, ini nilai default)
GEMINI_MODEL=gemini-3.6-flash
# Model cadangan (dipisah koma) bila model utama sibuk (503) atau dipensiunkan (404)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Opsional: kosongkan untuk memakai temperature bawaan model
GEMINI_TEMPERATURE=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Strategi intent detection: hybrid | keyword | llm
INTENT_MODE=hybrid

# Jumlah dokumen hasil retrieval yang dikirim ke LLM sebagai context
TOP_K=3

# Ambang skor cosine minimum agar query diteruskan ke LLM (0 = nonaktif)
RAG_MIN_SCORE=0
